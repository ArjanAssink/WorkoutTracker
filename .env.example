# Copy to .env (gitignored). Node CLIs load it via --env-file-if-exists; the shell
# scripts source it. Nothing here is secret except what you add — keep it out of git.

# Where the app is served and what it is called in Azure. Deliberately not in the repo.
WORKOUTS_URL=https://workouts.example.com
AZURE_RESOURCE_GROUP=workout-tracker
AZURE_FUNCTION_APP=workouts-func-xxxxxx
AZURE_STORAGE_ACCOUNT=workoutsstxxxxxx
GITHUB_REPO=owner/WorkoutTracker

# Athlete profile for the import CLIs. Effort is computed at write time — importing
# without the right heart rates silently scores every workout against the defaults.
# The Function App has its own copy in app settings; keep the two in step.

# Resting heart rate, bpm. Health → Browse → Heart → Resting Heart Rate (use the
# monthly average, not a single day).
ATHLETE_RESTING_HR=60
# Maximum heart rate, bpm — the fallback when no observed trailing-year max exists.
# Health has no such field; `npm run sync -- --max-hr` reads it out of an export for you.
ATHLETE_MAX_HR=185
ATHLETE_WEIGHT_KG=80
# Banister weighting: 1.92 for men, 1.67 for women.
ATHLETE_TRIMP_FACTOR=1.92

# Storage connection string. Leave unset and `npm run sync` fetches it from Azure.
# WORKOUTS_STORAGE=

# Optional: a folder with your real workbooks, to run the sample-file tests.
# WORKOUT_SAMPLES_DIR=/path/to/private/samples
