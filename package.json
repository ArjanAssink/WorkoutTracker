{
  "name": "workout-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Ingests Apple Health workouts (Shortcuts webhook + export.xml) into Azure Table Storage for retrospective training analysis.",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/import-health-export.js",
    "preview": "npm run build --silent && node dist/scripts/preview-dashboard.js",
    "sync": "./scripts/sync.sh",
    "add": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/add-workouts.js",
    "rescore": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/rescore.js",
    "lifts": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/import-lifts.js",
    "block": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/import-block-log.js"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.5",
    "sax": "^1.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sax": "^1.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
